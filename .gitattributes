# 줄바꿈 규칙 — 리눅스에서 실행되는 파일은 반드시 LF 로 유지한다.
# (CRLF 로 저장되면 리눅스에서 "bash: \r: command not found" 로 깨진다)
*.sh        text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.env       text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf

# 윈도우 전용 스크립트는 CRLF 유지
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf
*.vbs       text eol=crlf
