# PostgreSQL 접속정보 템플릿
# ─ 사용법: 이 파일 옆에 "db.env" 파일을 만들고 아래 한 줄을 실제 값으로 채우세요.
# ─ db.env 는 비밀번호가 들어있어 git 에 올라가지 않습니다(.gitignore).
# ─ 값을 채우면 앱이 자동으로 PostgreSQL 로 동작합니다(없으면 SQLite).
#
# 형식: postgresql://사용자명:비밀번호@호스트:포트/데이터베이스명
# 예)   postgresql://postgres:mypassword@localhost:5432/prism
#
DATABASE_URL=postgresql://사용자명:비밀번호@localhost:5432/데이터베이스명
PG_SCHEMA=prism
